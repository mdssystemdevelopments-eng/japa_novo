NODE_ENV=development
PORT=3001
# Docker (porta 5433): postgresql://japa:japa_dev_password@localhost:5433/japa_insufilm?schema=public
# Prisma Dev local: rode `npm run db:dev` e use a URL TCP exibida (ex.: postgres:postgres@localhost:51214)
DATABASE_URL=postgresql://japa:japa_dev_password@localhost:5433/japa_insufilm?schema=public
JWT_ACCESS_SECRET=altere_em_producao_access_min_32_chars
JWT_REFRESH_SECRET=altere_em_producao_refresh_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGIN=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
SEED_ADMIN_EMAIL=admin@japainsufilm.local
SEED_ADMIN_PASSWORD=AlterarSenha123!
